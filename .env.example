# Скопируй в .env (make check сделает это сам). Пароли учебные — стенд локальный.

POSTGRES_USER=platform
POSTGRES_PASSWORD=platform
POSTGRES_DB=platform

CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=platform

AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_SECRET_KEY=ab-platform-airflow

SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=admin
SUPERSET_SECRET_KEY=ab-platform-superset-secret

# --- Параметры симуляции ---
# Ускорение виртуального времени: 144 => 1 виртуальный день = 10 реальных минут
SIM_ACCEL=144
# Сколько виртуальных дней истории сгенерировать при первом старте (предпериод)
HISTORY_DAYS=45
# Пользователей на регион (6 регионов). 25000 => ~150k всего, бэкфилл истории занимает несколько минут
POP_PER_REGION=25000

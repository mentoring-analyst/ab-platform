# Принудительно LF: git на Windows по умолчанию подменяет переводы строк на CRLF,
# и скрипты/конфиги ломаются внутри Linux-контейнеров
* text=auto
*.sh text eol=lf
*.sql text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.md text eol=lf
*.ipynb text eol=lf
Makefile text eol=lf
*.b64 -text
*.png binary
